{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aether Setup",
  "mainBinaryName": "aetherchat-setup",
  "version": "1.6.0",
  "identifier": "app.aetherchat.setup",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
