{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aether",
  "mainBinaryName": "aetherchat",
  "version": "1.6.3",
  "identifier": "app.aetherchat.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "Aether",
        "url": "splash.html",
        "width": 300,
        "height": 360,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#08080f",
        "focus": true,
        "alwaysOnTop": false
      },
      {
        "title": "Aether",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#000000",
        "label": "main",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; media-src 'self' https: blob: mediastream:; connect-src 'self' ipc: http://ipc.localhost https: wss:; font-src 'self' data:; object-src 'none'; frame-src https://www.youtube-nocookie.com; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Aether",
    "category": "SocialNetworking",
    "shortDescription": "Lightweight P2P chat, voice and video",
    "longDescription": "Aether is a zero-cost messaging client: text over Supabase, voice, video and screen share directly peer-to-peer over WebRTC.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "aetherchat"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA3NjM2RkRERjMyMUI4MzcKUldRM3VDSHozVzlqQjc0NE9YcDF5dU54QlNncGVqZzErZFFwRm5LK240Vmk3Zmkyb3FWY2tJb2sK",
      "endpoints": [
        "https://github.com/NotNyxel/aether.chat-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
